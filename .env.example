# ====================================================
# Deployment Environment Contract (.env.example)
# ====================================================

# 1. Target Agent Selection ('all', '9router', or 'dsh')
ONLY=all

# 2. Domain Name Configuration
ROUTER_DOMAIN=9router.sontv.io.vn
DSH_DOMAIN=dsh.sontv.io.vn

# 3. 9Router Security & Authentication Setup
INITIAL_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-me-to-a-long-random-jwt-secret

# 4. Ports & Host Binding (Defaults)
# PORT_9ROUTER=20128
# PORT_DSH=3080
# HOST=127.0.0.1
